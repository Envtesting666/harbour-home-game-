; Godot 4.7 project. Open this file in Godot and press F6/F5.
config_version=5

[application]
config/name="Harbour & Home"
config/version="0.6.6"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Build a coastal neighbourhood. Homes, leases and a local economy. Playable development build."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/viewport_width.mobile=960
window/size/viewport_height.mobile=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=450
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
lights_and_shadows/use_physical_light_units=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.76,0.83,0.67,1)

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/integer_division=0
file_logging/log_path="user://logs/city.log"




